---
import type { Category } from '../consts';
import { CATEGORIES } from '../consts';

interface Props {
	category: Category;
	size?: 'sm' | 'md';
}

const { category, size = 'sm' } = Astro.props;
const cat = CATEGORIES[category];
---

<span class:list={['badge', `badge-${category}`, `badge-${size}`]}>
	{cat.labelZh}
</span>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		font-weight: 600;
		border-radius: var(--radius-full);
		white-space: nowrap;
		transition: transform var(--transition-fast);
	}

	.badge:hover {
		transform: scale(1.05);
	}

	.badge-sm {
		font-size: 0.75rem;
		padding: 0.2rem 0.625rem;
	}

	.badge-md {
		font-size: 0.8125rem;
		padding: 0.3rem 0.875rem;
	}

	.badge-tech {
		background: var(--color-tech-light);
		color: var(--color-tech-dark);
	}

	.badge-life {
		background: var(--color-life-light);
		color: var(--color-life-dark);
	}
</style>
