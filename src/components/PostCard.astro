---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CategoryBadge from './CategoryBadge.astro';
import FormattedDate from './FormattedDate.astro';
import type { Category } from '../consts';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	category: Category;
	tags?: string[];
	heroImage?: ImageMetadata;
	slug: string;
	featured?: boolean;
}

const { title, description, pubDate, category, tags = [], heroImage, slug, featured = false } = Astro.props;
---

<article class:list={['post-card', { featured }]}>
	<a href={`/blog/${slug}/`} class="post-card-link">
		{heroImage && (
			<div class="post-card-image">
				<Image
					src={heroImage}
					alt={title}
					width={featured ? 800 : 400}
					height={featured ? 400 : 225}
					loading="lazy"
				/>
			</div>
		)}
		<div class="post-card-content">
			<div class="post-card-meta">
				<CategoryBadge category={category} />
				<time class="post-card-date">
					<FormattedDate date={pubDate} />
				</time>
			</div>
			<h3 class="post-card-title">{title}</h3>
			<p class="post-card-desc">{description}</p>
			{tags.length > 0 && (
				<div class="post-card-tags">
					{tags.slice(0, 3).map((tag) => (
						<span class="tag">#{tag}</span>
					))}
				</div>
			)}
		</div>
	</a>
</article>

<style>
	.post-card {
		background: var(--color-bg-card);
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		overflow: hidden;
		transition: all var(--transition-base);
		animation: fadeInUp 0.5s ease-out forwards;
		opacity: 0;
	}

	.post-card:hover {
		border-color: var(--color-border-hover);
		box-shadow: var(--shadow-lg);
		transform: translateY(-2px);
	}

	.post-card-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.post-card-image {
		overflow: hidden;
		aspect-ratio: 16 / 9;
	}

	.post-card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--transition-slow);
		border-radius: 0;
	}

	.post-card:hover .post-card-image img {
		transform: scale(1.03);
	}

	.post-card-content {
		padding: var(--space-lg);
	}

	.post-card-meta {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		margin-bottom: var(--space-sm);
	}

	.post-card-date {
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.post-card-title {
		margin: 0 0 0.5rem 0;
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.4;
		color: var(--color-text);
		transition: color var(--transition-fast);
	}

	.post-card:hover .post-card-title {
		color: var(--color-accent);
	}

	.post-card-desc {
		margin: 0 0 0.75rem 0;
		font-size: 0.9rem;
		color: var(--color-text-secondary);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-card-tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.tag {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		transition: color var(--transition-fast);
	}

	.post-card:hover .tag {
		color: var(--color-text-secondary);
	}

	/* Featured post — full width */
	.featured {
		grid-column: 1 / -1;
	}

	.featured .post-card-title {
		font-size: 1.5rem;
	}

	/* Stagger animation */
	.post-card:nth-child(1) { animation-delay: 0s; }
	.post-card:nth-child(2) { animation-delay: 0.1s; }
	.post-card:nth-child(3) { animation-delay: 0.15s; }
	.post-card:nth-child(4) { animation-delay: 0.2s; }
	.post-card:nth-child(5) { animation-delay: 0.25s; }
	.post-card:nth-child(6) { animation-delay: 0.3s; }
</style>
