---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`鍏充簬鎴?| ${SITE_TITLE}`} description="鍏充簬 HenYan" />
		<style>
			.about-container {
				max-width: var(--content-width);
				margin: 0 auto;
				padding: var(--space-2xl) var(--space-lg);
				animation: fadeInUp 0.6s ease-out;
			}

			.about-header {
				text-align: center;
				margin-bottom: var(--space-2xl);
			}

			.about-avatar {
				width: 120px;
				height: 120px;
				border-radius: 50%;
				background: linear-gradient(135deg, var(--color-accent), var(--color-accent-hover));
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 3rem;
				margin: 0 auto var(--space-lg);
			}

			.about-header h1 {
				font-size: 2.25rem;
				font-weight: 800;
				letter-spacing: -0.03em;
				margin-bottom: 0.5rem;
			}

			.about-header p {
				color: var(--color-text-secondary);
				font-size: 1.0625rem;
				margin: 0;
			}

			.about-content {
				line-height: 1.8;
				font-size: 1.0625rem;
			}

			.about-content h2 {
				margin-top: 2.5rem;
				margin-bottom: 1rem;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid var(--color-border);
			}

			.about-content p {
				margin-bottom: 1.5rem;
				color: var(--color-text);
			}

			.contact-links {
				display: flex;
				gap: var(--space-md);
				flex-wrap: wrap;
				margin-top: var(--space-lg);
			}

			.contact-link {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.625rem 1.25rem;
				background: var(--color-bg-card);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-full);
				font-size: 0.9rem;
				font-weight: 500;
				color: var(--color-text);
				text-decoration: none;
				transition: all var(--transition-fast);
			}

			.contact-link:hover {
				border-color: var(--color-accent);
				color: var(--color-accent);
				box-shadow: var(--shadow-sm);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="about-container">
				<div class="about-header">
					<div class="about-avatar">馃懆鈥嶐煉?/div>
					<h1>鍏充簬鎴?/h1>
					<p>AI Explorer / Builder / Thinker</p>
				</div>
				<div class="about-content">
					<h2>馃憢 Hi</h2>
					<p>
						鎴戞槸 HenYan锛屼竴涓 AI 鍜屾妧鏈厖婊＄儹鎯呯殑鎺㈢储鑰呫€?					</p>

					<h2>馃敡 鎶€鏈爤</h2>
					<p>
						鐩墠涓昏鍏虫敞 AI Agent 鏋舵瀯銆佷紭鍖栫畻娉曘€佷互鍙婂叏鏍堝紑鍙戙€傚枩娆㈢敤鎶€鏈В鍐冲疄闄呴棶棰橈紝涔熷枩娆㈡帰绱㈡柊鐨勫彲鑳芥€с€?					</p>

					<h2>鉁嶏笍 杩欎釜鍗氬</h2>
					<p>
						杩欎釜鍗氬鏄竴涓叕寮€鐭ヨ瘑搴擄紝璁板綍 AI Agent 鏋舵瀯銆佸伐绋嬪疄璺靛拰鎶€鏈帰绱€?						鍐呭鐢?LogicAI Agent 绯荤粺杈呭姪鐢熶骇锛岀粡杩囧鏍稿悗鍙戝竷銆?					</p>

					<h2>馃摤 鑱旂郴鎴?/h2>
					<div class="contact-links">
						<a href="https://github.com/" class="contact-link" target="_blank">
							馃敆 GitHub
						</a>
						<a href="mailto:hello@henyan224.com" class="contact-link">
							馃摟 Email
						</a>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
