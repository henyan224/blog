---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_TITLE, CATEGORIES } from '../../consts';
import type { Category } from '../../consts';

export function getStaticPaths() {
	return [
		{ params: { category: 'tech' } },
		{ params: { category: 'life' } },
	];
}

const { category } = Astro.params as { category: Category };
const cat = CATEGORIES[category];

const posts = (await getCollection('blog', ({ data }) => data.category === category && !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${cat.labelZh} | ${SITE_TITLE}`} description={cat.description} />
		<style>
			.page-header {
				padding: var(--space-2xl) 0;
				text-align: center;
				animation: fadeInUp 0.5s ease-out;
			}

			.page-header h1 {
				font-size: 2.25rem;
				font-weight: 800;
				letter-spacing: -0.03em;
				margin-bottom: 0.5rem;
			}

			.page-header p {
				color: var(--color-text-secondary);
				font-size: 1.0625rem;
				margin: 0;
			}

			.category-indicator {
				display: inline-block;
				width: 12px;
				height: 12px;
				border-radius: 50%;
				margin-right: 0.5rem;
			}

			.post-count {
				display: inline-flex;
				align-items: center;
				gap: 0.25rem;
				background: var(--color-bg-code);
				padding: 0.2rem 0.75rem;
				border-radius: var(--radius-full);
				font-size: 0.8125rem;
				color: var(--color-text-muted);
				margin-top: var(--space-md);
			}

			.post-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
				gap: var(--space-xl);
				margin-bottom: var(--space-3xl);
			}

			.empty-state {
				text-align: center;
				padding: var(--space-3xl);
				color: var(--color-text-muted);
			}

			@media (max-width: 768px) {
				.page-header h1 {
					font-size: 1.75rem;
				}

				.post-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="container">
			<div class="page-header">
				<h1>
					<span class="category-indicator" style={`background-color: ${cat.color}`}></span>
					{cat.labelZh}
				</h1>
				<p>{cat.description}</p>
				<span class="post-count">共 {posts.length} 篇</span>
			</div>
			{posts.length > 0 ? (
				<div class="post-grid">
					{posts.map((post) => (
						<PostCard
							title={post.data.title}
							description={post.data.description}
							pubDate={post.data.pubDate}
							category={post.data.category}
							tags={post.data.tags}
							heroImage={post.data.heroImage}
							slug={post.id}
						/>
					))}
				</div>
			) : (
				<div class="empty-state">
					<p>这个分类下还没有文章 ✨</p>
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>
